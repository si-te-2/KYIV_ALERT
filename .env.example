# Reserved for later stages. ASP.NET Core reads environment variables.
# .env files require explicit loading by your local tooling.
DemoMode=true
ASPNETCORE_URLS=http://127.0.0.1:5080
# Configure locally at the Telegram/database stages.
Telegram__BotToken=
ConnectionStrings__Postgres=

# Optional nationwide civil alert feed. Keep the token on the server.
CivilAlerts__NationalApiToken=

# Optional Telegram sources for unverified regional warnings. Comma-separated usernames.
# Empty disables the unverified layer. Use channels you are authorized to read.
# Example: kyiv_nebo,ppo_kiev,tlknewsua,nebo_raketa,smolii_ukraine,StrategicaviationT,ukraine_pyxx,kpszsu,war_monitor
CivilAlerts__MonitoringChannels=

# Optional public ASP.NET API. Server settings only; never put Telegram credentials into VITE_*.
PublicApi__AllowedOrigin=https://si-te-2.github.io
PublicApi__ReadOnly=true
# Private absolute paths outside the repository and wwwroot. Leave empty for local default.
# Telegram__SessionDirectory=/tmp/kyiv-alert-telegram
# Telegram__SessionSeedFile=/etc/secrets/telegram-session.base64
# Public frontend build setting (HTTPS origin only, no path or secret).
VITE_PUBLIC_API_ORIGIN=
