# Reserved for later stages. ASP.NET Core reads environment variables.
# .env files require explicit loading by your local tooling.
DemoMode=true
ASPNETCORE_URLS=http://127.0.0.1:5080
# Configure locally at the Telegram/database stages.
Telegram__BotToken=
ConnectionStrings__Postgres=

# Optional nationwide civil alert feed. Keep the token on the server.
CivilAlerts__NationalApiToken=

# Optional Telegram channels with standalone regional civil notices. Comma-separated usernames.
# Empty disables the unverified layer. Use channels you are authorized to read.
CivilAlerts__MonitoringChannels=
